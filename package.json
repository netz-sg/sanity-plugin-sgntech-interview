{
  "name": "sanity-plugin-sgntech-interview",
  "version": "1.0.0",
  "description": "Interview blocks for Sanity Studio — question and answer pairs with speakers, timestamps and a note when an answer was translated.",
  "keywords": [
    "sanity",
    "sanity-plugin",
    "interview",
    "portable-text",
    "editorial",
    "qa"
  ],
  "homepage": "https://github.com/netz-sg/sanity-plugin-sgntech-interview#readme",
  "bugs": {
    "url": "https://github.com/netz-sg/sanity-plugin-sgntech-interview/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/netz-sg/sanity-plugin-sgntech-interview.git"
  },
  "license": "MIT",
  "author": "SGNTech <kontakt@lifad.world>",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./render": {
      "source": "./src/render.ts",
      "default": "./dist/render.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "plugin-kit verify-package --silent && pkg-utils build --strict --check --clean",
    "format": "oxfmt",
    "link-watch": "plugin-kit link-watch",
    "lint": "oxlint",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "watch": "pkg-utils watch --strict"
  },
  "dependencies": {
    "@sanity/icons": "^5.2.1"
  },
  "devDependencies": {
    "@sanity/browserslist-config": "^1.0.5",
    "@sanity/pkg-utils": "^11.0.17",
    "@sanity/plugin-kit": "^10.0.3",
    "@types/react": "^19.2.18",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanity": "^6.9.0",
    "styled-components": "^6.5.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4",
    "@portabletext/react": "^7.0.1",
    "@portabletext/types": "^4.0.2"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "sanity": "^5 || ^6.0.0-0",
    "@portabletext/react": "^3 || ^4 || ^5 || ^6 || ^7"
  },
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "browserslist": "extends @sanity/browserslist-config",
  "publishConfig": {
    "exports": {
      ".": {
        "default": "./dist/index.js"
      },
      "./render": {
        "default": "./dist/render.js"
      },
      "./package.json": "./package.json"
    }
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  },
  "peerDependenciesMeta": {
    "@portabletext/react": {
      "optional": true
    }
  }
}
